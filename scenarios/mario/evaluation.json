{
    "description": "Player experience evaluation metrics for Super Mario Bros.-style maps.",
    "experience_metrics": {
        "description": "These items use a 5-point Likert scale (1: Strongly Disagree ~ 5: Strongly Agree)",
        "metrics": [
            {
                "name": "enjoyment",
                "survey_item": "It was fun to play.",
                "description": "Measures the fundamental enjoyment and fun of the gameplay.",
                "scale": [
                    {"range": [1, 1], "description": "Strongly Disagree"},
                    {"range": [2, 2], "description": "Disagree"},
                    {"range": [3, 3], "description": "Neutral"},
                    {"range": [4, 4], "description": "Agree"},
                    {"range": [5, 5], "description": "Strongly Agree"}
                ]
            },
            {
                "name": "difficulty",
                "survey_item": "It was very challenging.",
                "description": "Measures cognitive and operational difficulty, as well as the desire for challenge.",
                "scale": [
                    {"range": [1, 1], "description": "Strongly Disagree"},
                    {"range": [2, 2], "description": "Disagree"},
                    {"range": [3, 3], "description": "Neutral"},
                    {"range": [4, 4], "description": "Agree"},
                    {"range": [5, 5], "description": "Strongly Agree"}
                ]
            },
            {
                "name": "frustration",
                "survey_item": "I felt frustrated while playing it.",
                "description": "Captures negative emotions, feelings of unfairness, or feeling stuck.",
                "scale": [
                    {"range": [1, 1], "description": "Strongly Disagree"},
                    {"range": [2, 2], "description": "Disagree"},
                    {"range": [3, 3], "description": "Neutral"},
                    {"range": [4, 4], "description": "Agree"},
                    {"range": [5, 5], "description": "Strongly Agree"}
                ]
            },
            {
                "name": "novelty",
                "survey_item": "It had surprises or unexpected elements.",
                "description": "Evaluates novelty or unexpectedness compared to existing games.",
                "scale": [
                    {"range": [1, 1], "description": "Strongly Disagree"},
                    {"range": [2, 2], "description": "Disagree"},
                    {"range": [3, 3], "description": "Neutral"},
                    {"range": [4, 4], "description": "Agree"},
                    {"range": [5, 5], "description": "Strongly Agree"}
                ]
            },
            {
                "name": "aesthetics",
                "survey_item": "The layout felt well-designed and high quality.",
                "description": "Assesses the completeness of the level composition and visual harmony.",
                "scale": [
                    {"range": [1, 1], "description": "Strongly Disagree"},
                    {"range": [2, 2], "description": "Disagree"},
                    {"range": [3, 3], "description": "Neutral"},
                    {"range": [4, 4], "description": "Agree"},
                    {"range": [5, 5], "description": "Strongly Agree"}
                ]
            }
        ]
    },
    "perception_metrics": {
        "description": "Measures the player's perception of the creator after completing the experience metrics.",
        "metrics": [
            {
                "name": "creator_belief",
                "survey_item": "Who do you think designed this level?",
                "type": "binary_choice",
                "options": [
                    {"value": "AI-generated", "description": "Generated by a computer algorithm"},
                    {"value": "Human-designed", "description": "Designed by a human"}
                ]
            },
            {
                "name": "confidence_level",
                "survey_item": "How confident are you in your answer?",
                "type": "3_point_scale",
                "options": [
                    {"value": 1, "description": "Not Confident", "detail": "No confidence / guessed"},
                    {"value": 2, "description": "Somewhat Confident", "detail": "Some confidence"},
                    {"value": 3, "description": "Confident", "detail": "Very confident"}
                ]
            }
        ]
    },
    "qualitative_reasoning": {
        "description": "Open-ended question to understand the reasoning behind the numerical data.",
        "metrics": [
            {
                "name": "reasoning_for_creator_belief",
                "survey_item": "What specific elements of the level led you to believe it was [AI-generated / Human-designed]?",
                "type": "open_ended",
                "analysis_cues": {
                    "human_like_cues": [
                        "Strategic placement",
                        "Intentional shortcuts",
                        "Mistake-like quirks (human error)"
                    ],
                    "ai_like_cues": [
                        "Simple repetition",
                        "Randomness",
                        "Overly complex or simplistic design"
                    ]
                }
            }
        ]
    }
}